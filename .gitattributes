# Formatter-managed web text is canonical LF on every development/CI platform.
/web/**/*.ts text eol=lf
/web/**/*.mjs text eol=lf
/web/**/*.css text eol=lf
/web/**/*.html text eol=lf
/web/package.json text eol=lf
/web/package-lock.json text eol=lf
/web/tsconfig.json text eol=lf
/web/.oxlintrc.json text eol=lf
/web/.prettierrc.json text eol=lf
/.github/**/*.yml text eol=lf

# Preserve downloaded font/license bytes and the existing cache-bound normalizer.
/web/public/fonts/** -text
/drive_model_names.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
