/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/data/index.json
  Cache-Control: no-cache
/data/2026-Q2.json
  Cache-Control: public, max-age=300, must-revalidate
/data/production/index.json
  Cache-Control: no-cache
/data/production/:generation/*.json
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: no-cache
